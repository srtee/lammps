units real
atom_style full
region box block -5 5 -5 5 -5 5
create_box 3 box bond/types 2 angle/types 2 &
  extra/bond/per/atom 3 extra/angle/per/atom 3 &
  extra/special/per/atom 3

mass 1 15.8994
mass 2 1.008
mass 3 1e-6

pair_style lj/cut/coul/long 12.0
pair_coeff 1 1 0.1550 3.1536
pair_coeff 2 2 0.0    1.0
pair_coeff 3 3 0.0    1.0
kspace_style pppm 1e-5
bond_style zero
bond_coeff 1 0.9574
bond_coeff 2 0.15

neigh_modify every 1 delay 0

angle_style zero
angle_coeff 1 104.52
angle_coeff 2 52.26
molecule water tip4p.mol
create_atoms 0 random 33 34564 NULL mol water 25367 overlap 1.33

timestep 4.0
fix rigid all rigs 1e-12 1000 1000 b 1 2 a 1 2
minimize 1e-8 1e-10 10000 100000
write_data min_demoted.data nocoeff

fix integrate all nvt temp 300.0 300.0 100.0

group o type 1
group h type 2
group m type 3
compute keo o ke
compute keh h ke
compute kem m ke

reset_timestep 0

thermo_style custom step temp etotal pe ke c_keo c_keh c_kem
thermo 100
run 5000
write_data tip4p-explicit.data nocoeff
