units real
atom_style full
pair_style lj/cut/coul/long 8.0
kspace_style pppm 1e-4
bond_style zero
angle_style zero

read_data tip4p-explicit.data
mass 1 15.8994
mass 2 1.008
mass 3 0.1

pair_coeff 1 1 0.1550 3.1536
pair_coeff 2 2 0.0    1.0
pair_coeff 3 3 0.0    1.0
bond_coeff 1 0.9574
bond_coeff 2 0.15

angle_coeff 1 104.52
angle_coeff 2 57

timestep 0.5
fix rigid all rigs 1e-8 1000 10 b 1 2 #a 1 2
#minimize 1e-6 1e-8 1000 10000
fix integrate all nvt temp 300.0 300.0 100.0

thermo_style custom step temp press etotal density pe ke
thermo 500
run 5000
write_data tip4p-explicit.data nocoeff

