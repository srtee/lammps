# TIP4P electrode simulation with explicit virtual charge sites, for comparison
units real
if "$(extract_setting(world_size) % 2) == 0" then "processors * * 2"

atom_style full
pair_style lj/cut/coul/long 8
kspace_style pppm 1e-5
bond_style zero
angle_style zero

read_data "tip4p_ex.data"
comm_modify cutoff 12
# for ffield, remove change_box and omit slab
change_box all boundary p p f
kspace_modify mesh 45 45 90 gewald 0.388 slab 3.0

group wat type 2 4 7
fix wat_integrate wat rigid/nvt/small molecule temp 300.0 300.0 100.0
group salt type 1 3
fix salt_integrate salt nve

variable q atom q
variable px atom mass*vx
variable py atom mass*vy
variable pz atom mass*vz

group sol union wat salt
group top type 5
group bot type 6

compute p sol reduce sum v_px v_py v_pz
compute qtop top reduce sum v_q
compute qbot bot reduce sum v_q

fix ele top electrode/conp 2.0 1.805 couple bot 0.0 symm on
# for ffield, use fix ele top electrode/conp 2.0 1.805 couple bot 0.0 symm on ffield on

thermo_style custom step temp etotal c_p[1] c_p[2] c_p[3] c_qtop c_qbot
thermo_modify flush yes
thermo 10
# short steps and run because dynamics diverge fast, even without electrode
timestep 0.5
run 100
