# TIP4P electrode simulation with implicit virtual charge sites
units real
if "$(extract_setting(world_size) % 2) == 0" then "processors * * 2"

atom_style full
#pair_style arguments: typeO typeH bond angle qdist cutoff
pair_style lj/cut/tip4p/long 4 2 1 1 0.125 8.0
kspace_style pppm/tip4p 1e-5
bond_style zero
angle_style zero

read_data "tip4p_ex.data"
comm_modify cutoff 12
# for ffield, remove change_box and omit slab
change_box all boundary p p f
kspace_modify mesh 45 45 90 gewald 0.388 slab 3.0

# remove vsites for use with TIP4P styles
delete_bonds all bond 2 remove special
group vsites type 7
delete_atoms group vsites
set type 4 charge -1.04844

group wat type 2 4
fix rigid wat shake 0.0001 10 10000 b 1 a 1
fix wat_integrate wat nvt temp 300.0 300.0 100.0
group salt type 1 3
fix salt_integrate salt nve

variable q atom q
variable px atom mass*vx
variable py atom mass*vy
variable pz atom mass*vz

group sol union wat salt
group top type 5
group bot type 6

compute p sol reduce sum v_px v_py v_pz
compute qtop top reduce sum v_q
compute qbot bot reduce sum v_q

fix ele top electrode/conp 2.0 1.805 couple bot 0.0 symm on
# for ffield, use: fix ele top electrode/conp 0.0 1.805 couple bot 0.0 symm on ffield_tip4p on

thermo_style custom step temp etotal c_p[1] c_p[2] c_p[3] c_qtop c_qbot
thermo_modify flush yes
thermo 10
# short steps and run because dynamics diverge fast, even without electrode
timestep 0.5
run 100
